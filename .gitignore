# Dependencies
node_modules/

# Distribution artifacts
*.tgz
*.tar.gz

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Runtime / diagnostic artifacts (should never be committed)
.dfu-*
uploads/
.dsh-vision-toolkit/

# The lockfile is not tracked: devDependencies resolve from package.json
pnpm-lock.yaml

# Sandbox-local package caches (read-only HOME workarounds)
.xdg/

# Build output — `pnpm build` regenerates these; they are git-ignored and ship
# only inside the release tarball / npm package, never from the git tree.
lib/
client/src/client.js
